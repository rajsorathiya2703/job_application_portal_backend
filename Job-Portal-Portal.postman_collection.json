    {
      "name": "Tag",
      "item": [
        {
          "name": "Get Tags",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/tags?appliesOn=skill",
              "host": ["{{baseUrl}}"],
              "path": ["tags"],
              "query": [
                { "key": "appliesOn", "value": "skill", "description": "Optional: 'job' or 'skill'" }
              ]
            },
            "description": "Public route. Get all tags, optionally filtered by appliesOn."
          }
        },
        {
          "name": "Create Tag",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Python\",\n  \"appliesOn\": \"skill\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/tags",
              "host": ["{{baseUrl}}"],
              "path": ["tags"]
            },
            "description": "Requires 'recruiter' role."
          }
        }
      ]
    },
    {
      "name": "Job",
      "item": [
        {
          "name": "Get Jobs (Search)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/jobs?search=Developer&jobType=full_time&workMode=remote&page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["jobs"],
              "query": [
                { "key": "search", "value": "Developer" },
                { "key": "jobType", "value": "full_time" },
                { "key": "workMode", "value": "remote" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            },
            "description": "Public route. Search open jobs."
          }
        },
        {
          "name": "Get Job By ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/jobs/:id",
              "host": ["{{baseUrl}}"],
              "path": ["jobs", ":id"],
              "variable": [{ "key": "id", "value": "" }]
            },
            "description": "Public route."
          }
        },
        {
          "name": "Create Job",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Backend Software Engineer\",\n  \"description\": \"Develop scalable backend services.\",\n  \"jobType\": \"full_time\",\n  \"workMode\": \"remote\",\n  \"location\": {\n    \"city\": \"Denver\",\n    \"state\": \"CO\",\n    \"country\": \"USA\",\n    \"isRemote\": true\n  },\n  \"totalExperience\": { \"min\": 2, \"max\": 5 },\n  \"tags\": [],\n  \"openPositions\": 3,\n  \"status\": \"open\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/jobs",
              "host": ["{{baseUrl}}"],
              "path": ["jobs"]
            },
            "description": "Requires 'recruiter' role."
          }
        },
        {
          "name": "Update Job",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"closed\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/jobs/:id",
              "host": ["{{baseUrl}}"],
              "path": ["jobs", ":id"],
              "variable": [{ "key": "id", "value": "" }]
            },
            "description": "Requires 'recruiter' role."
          }
        },
        {
          "name": "Delete Job",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/jobs/:id",
              "host": ["{{baseUrl}}"],
              "path": ["jobs", ":id"],
              "variable": [{ "key": "id", "value": "" }]
            },
            "description": "Requires 'recruiter' role."
          }
        },
        {
          "name": "Get My Posted Jobs",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/jobs/recruiter/mine",
              "host": ["{{baseUrl}}"],
              "path": ["jobs", "recruiter", "mine"]
            },
            "description": "Requires 'recruiter' role."
          }
        }
      ]
    },
    {
      "name": "Resume",
      "item": [
        {
          "name": "Upload Resume",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "resume",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/resumes",
              "host": ["{{baseUrl}}"],
              "path": ["resumes"]
            },
            "description": "Requires 'job_seeker' role. Accepts PDF, DOC, DOCX up to 5MB."
          }
        },
        {
          "name": "Get My Resumes",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/resumes",
              "host": ["{{baseUrl}}"],
              "path": ["resumes"]
            },
            "description": "Requires 'job_seeker' role."
          }
        },
        {
          "name": "Set Default Resume",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/resumes/:id/default",
              "host": ["{{baseUrl}}"],
              "path": ["resumes", ":id", "default"],
              "variable": [{ "key": "id", "value": "" }]
            },
            "description": "Requires 'job_seeker' role."
          }
        },
        {
          "name": "Delete Resume",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/resumes/:id",
              "host": ["{{baseUrl}}"],
              "path": ["resumes", ":id"],
              "variable": [{ "key": "id", "value": "" }]
            },
            "description": "Requires 'job_seeker' role."
          }
        }
      ]
    },
    {
      "name": "Application",
      "item": [
        {
          "name": "Apply for Job",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jobId\": \"<Job_ObjectId>\",\n  \"resumeId\": \"<Resume_ObjectId>\",\n  \"coverLetter\": \"I am very interested in this role.\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/applications",
              "host": ["{{baseUrl}}"],
              "path": ["applications"]
            },
            "description": "Requires 'job_seeker' role."
          }
        },
        {
          "name": "Get My Applications",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/applications/me?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["applications", "me"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            },
            "description": "Requires 'job_seeker' role."
          }
        },
        {
          "name": "Get Applications for Job",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/applications/job/:jobId?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["applications", "job", ":jobId"],
              "variable": [{ "key": "jobId", "value": "" }],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            },
            "description": "Requires 'recruiter' role. Must be the recruiter who posted the job."
          }
        },
        {
          "name": "Update Application Status",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"shortlisted\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/applications/:id/status",
              "host": ["{{baseUrl}}"],
              "path": ["applications", ":id", "status"],
              "variable": [{ "key": "id", "value": "" }]
            },
            "description": "Requires 'recruiter' role. Valid statuses: applied, under_review, shortlisted, rejected, hired, withdrawn."
          }
        },
        {
          "name": "Withdraw Application",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/applications/:id/withdraw",
              "host": ["{{baseUrl}}"],
              "path": ["applications", ":id", "withdraw"],
              "variable": [{ "key": "id", "value": "" }]
            },
            "description": "Requires 'job_seeker' role. Only works if status is applied or under_review."
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    }
  ]
}
